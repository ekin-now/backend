# Supabase Session Pooler (Settings → Database → Connection pooling → Session mode)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your-password
DB_NAME=postgres
DB_SSL=false
# Set to false only for local dev with Supabase Session Pooler (self-signed cert)
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Cloudflare R2 — Settings → R2 → your bucket → API
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public URL: enable "Public access" on the bucket or use a custom domain
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
